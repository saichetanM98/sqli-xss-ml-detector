# Server Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# Database Configuration
# MongoDB
MONGO_URI=mongodb://localhost:27017/adaptive_security_gateway
# or PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/security_gateway

# Model & Inference
MODEL_PATH=ml/artifacts/best_model.pt
VOCAB_PATH=ml/artifacts/vocab.json
DEVICE=cuda

# Thresholds & Rules
SQLI_THRESHOLD=0.85
XSS_THRESHOLD=0.85
RISK_THRESHOLD_BLOCK=80
RISK_THRESHOLD_MONITOR=40
